 #include "DarwinSpeechSynthesizer.h"
+#import <Foundation/Foundation.h>
 #import <AVFoundation/AVFoundation.h>
 
+#if __MAC_OS_X_VERSION_MAX_ALLOWED < 101500
+// AVSpeechSynthesizer is not available in older macOS SDKs / on macOS < 10.15 (e.g. High Sierra).
+// Fall back to the older AppKit NSSpeechSynthesizer, which exists on every macOS version.
+#import <AppKit/AppKit.h>
+
+DarwinSpeechSynthesizer::DarwinSpeechSynthesizer() {}
+
+bool DarwinSpeechSynthesizer::DoInit() {
+    mSynthesizer = (__bridge_retained void*)[[NSSpeechSynthesizer alloc] init];
+    return true;
+}
+
+void DarwinSpeechSynthesizer::DoUninitialize() {
+    NSSpeechSynthesizer* synth = (__bridge_transfer NSSpeechSynthesizer*)mSynthesizer;
+    [synth stopSpeaking];
+    mSynthesizer = nullptr;
+}
+
+void DarwinSpeechSynthesizer::Speak(const char* text, const char* language) {
+    (void)language; // uses the system default voice
+    NSSpeechSynthesizer* synth = (__bridge NSSpeechSynthesizer*)mSynthesizer;
+    [synth stopSpeaking];
+    [synth startSpeakingString:@(text)];
+}
+#else
+
 DarwinSpeechSynthesizer::DarwinSpeechSynthesizer() {}
 
 bool DarwinSpeechSynthesizer::DoInit() {
@@ -31,3 +58,4 @@ void DarwinSpeechSynthesizer::Speak(const char* text, const char* language) {
     [(__bridge AVSpeechSynthesizer *)mSynthesizer stopSpeakingAtBoundary:AVSpeechBoundaryImmediate];
